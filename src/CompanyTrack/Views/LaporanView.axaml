<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CompanyTrack.Views.LaporanView">
  <ScrollViewer>
    <StackPanel Margin="28,22" Spacing="14">
      <Grid ColumnDefinitions="*,260">
        <StackPanel>
          <TextBlock Classes="h1" Text="Laporan"/>
          <TextBlock Classes="muted" Text="{Binding Summary}"/>
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding PeriodeOptions}" SelectedItem="{Binding SelectedPeriode}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Funnel pipeline"/>
          <ItemsControl ItemsSource="{Binding Funnel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="160,*,32" Margin="0,3">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding Max}" Value="{Binding Jumlah}" Foreground="#2563EB" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Jumlah}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Tingkat keberhasilan per industri"/>
          <Grid ColumnDefinitions="*,80,100,90,90">
            <TextBlock Classes="muted" Text="Industri"/>
            <TextBlock Grid.Column="1" Classes="muted" Text="Total"/>
            <TextBlock Grid.Column="2" Classes="muted" Text="Diterima"/>
            <TextBlock Grid.Column="3" Classes="muted" Text="Ditolak"/>
            <TextBlock Grid.Column="4" Classes="muted" Text="Tingkat"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Industri}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,80,100,90,90" Margin="0,4">
                  <TextBlock Text="{Binding Industri}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Total}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Diterima}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Ditolak}"/>
                  <TextBlock Grid.Column="4" Text="{Binding Persen}" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Alasan penolakan atau pembatalan"/>
          <ItemsControl ItemsSource="{Binding Alasan}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="260,*,32" Margin="0,3">
                  <TextBlock Text="{Binding Alasan}" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding Max}" Value="{Binding Jumlah}" Foreground="#DC2626" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Jumlah}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
