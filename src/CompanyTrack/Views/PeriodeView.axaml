<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CompanyTrack.Views.PeriodeView">
  <ScrollViewer>
    <StackPanel Margin="28,22" Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Periode"/>
          <TextBlock Classes="muted" Text="Hanya satu periode yang dapat aktif. Perubahan periode hanya untuk Kepala Departemen."/>
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Content="Tambah periode" Command="{Binding NewPeriodeCommand}" IsVisible="{Binding CanManage}" VerticalAlignment="Center"/>
      </Grid>

      <Border Classes="card" IsVisible="{Binding IsFormOpen}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding FormTitle}"/>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Margin="0,0,10,0"><TextBlock Classes="label" Text="Nama periode"/><TextBox Text="{Binding FormNama}"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Classes="label" Text="Tanggal kunjungan"/><CalendarDatePicker SelectedDate="{Binding FormTanggal}" HorizontalAlignment="Stretch"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Target perusahaan"/><TextBox Text="{Binding FormTarget}"/></StackPanel>
          </Grid>
          <CheckBox IsChecked="{Binding FormAktif}" Content="Jadikan periode aktif (periode lain otomatis nonaktif)"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Simpan" Command="{Binding SaveFormCommand}"/>
            <Button Classes="ghost" Content="Batal" Command="{Binding CancelFormCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Padding="16,12" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,160,160,100,Auto">
                <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Tanggal}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Target}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="4" Classes="ghost" Content="Ubah" Command="{Binding EditCommand}" IsVisible="{Binding CanManage}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
